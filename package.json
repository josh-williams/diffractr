{
  "name": "diffractr",
  "version": "0.1.0",
  "private": true,
  "description": "Local code reviews organized by behavior, with agent-authored explanations and anchored feedback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-williams/diffractr.git"
  },
  "bin": {
    "diffractr": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "review": "node scripts/review.mjs",
    "build": "tsc -b && vite build && node scripts/build-cli.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "diffractr": "node scripts/cli.mjs",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@oxlint/plugins": "1.83.0",
    "@pierre/diffs": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.42.0",
    "mermaid": "^11.17.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
